<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#2A2A2A">

    <!-- Título dinámico: "Agregar Cuenta" o "Modificar Cuenta" -->
    <TextView
        android:id="@+id/txtTituloDialog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Agregar Cuenta"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="20dp" />

    <!-- Campo: Nombre -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Nombre"
        android:textColor="#BDBDBD"
        android:textSize="12sp"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/editNombre"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Ej: Mi cuenta corriente"
        android:textColor="#FFFFFF"
        android:textColorHint="#80FFFFFF"
        android:backgroundTint="#40C4FF"
        android:inputType="textCapSentences"
        android:layout_marginBottom="16dp" />

    <!-- Campo: Descripción -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Descripción"
        android:textColor="#BDBDBD"
        android:textSize="12sp"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/editDescripcion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Ej: Cuenta de uso diario"
        android:textColor="#FFFFFF"
        android:textColorHint="#80FFFFFF"
        android:backgroundTint="#40C4FF"
        android:inputType="textCapSentences"
        android:layout_marginBottom="16dp" />

    <!-- Selector de icono -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Icono"
        android:textColor="#BDBDBD"
        android:textSize="12sp"
        android:layout_marginBottom="4dp" />

    <Spinner
        android:id="@+id/spinnerIconos"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/spinner_darkbg"
        android:layout_marginBottom="24dp" />

    <!-- Vista previa del icono seleccionado -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Vista previa:"
            android:textColor="#BDBDBD"
            android:textSize="12sp"
            android:layout_marginEnd="12dp" />

        <ImageView
            android:id="@+id/imgVistaPrevia"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="Vista previa del icono" />

    </LinearLayout>

    <!-- Botones -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <Button
            android:id="@+id/btnCancelar"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cancelar"
            android:textColor="#BDBDBD" />

        <Button
            android:id="@+id/btnGuardar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Guardar"
            android:backgroundTint="#40C4FF"
            android:textColor="#1E1E1E"
            android:layout_marginStart="8dp" />

    </LinearLayout>

</LinearLayout>
